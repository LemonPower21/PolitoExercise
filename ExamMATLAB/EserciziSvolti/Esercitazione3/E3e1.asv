function [m,lambda] = potenze(mmax,toll,z,A)
%NORMALIZZO
w = z/norm(z);
lambda=0;
for m=1:mmax
    %CALCOLO Z(m+1)
    z = A*w;
    %CALCOLO L = w(m)'*z(m+1)
    lambdamax = w'*z;

    if(norm(lambda-lambdamax)<=toll*lambdamax)
        break
    end
    w = z/norm(z);
    lambda = lambdamax;
end
end

z = [1 2 3 ]';
toll = 1e-10;
A1 = [1 2 0; 1 0 0 ; 0 1 0];
A2 = [0.1 3.8 0; 1 0 0;0 1 0];
A3 = [0 -1 0; 1 0 0 ; 0 1 0];
it = 100;

potenze(it,toll,z,A1)
potenze(it,toll,z,A2)
potenze(it,toll,z,A3)

